# Quetzaltic Environment Configuration Template

# Runtime Environment
# Allowed: dev, qa, prod
NODE_ENV=dev

# Server Port
PORT=3000

# Rate Limiting
# TTL in milliseconds
RATE_LIMIT_TTL=60000
# Max requests per client within TTL
RATE_LIMIT_LIMIT=10

# Unified Database URL (One physical DB with multiple schemas)
DATABASE_URL=postgresql://user:password@localhost:5432/quetzaltic_db?schema=prod

# Production Database URL (Target for audit/shield)
# Use a placeholder for local development
PROD_DB_URL=postgresql://user:password@localhost:5432/prod_db?schema=public

# Audit Database URL (Immutable store)
# Use a placeholder for local development
AUDIT_DB_URL=postgresql://user:password@localhost:5432/audit_db?schema=public

# Security
# Min length: 32 characters
JWT_SECRET=provide_a_secure_random_string_of_exactly_or_more_than_32_chars
