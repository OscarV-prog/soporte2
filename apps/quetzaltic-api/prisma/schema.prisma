generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}


model MigrationMeta {
  id        Int      @id @default(autoincrement())
  appliedAt DateTime @default(now())
  version   String
}

model AuditEvent {
  id               String   @id @default(uuid())
  correlationId    String   @map("correlation_id")
  ticketId         String?  @map("ticket_id")
  actor            String
  type             String   @default("OPERATION") // OPERATION | POLICY_CHANGE | SYSTEM_LOCKDOWN
  tableName        String   @map("table_name")
  primaryKeyColumn String   @map("primary_key_column")
  primaryKeyValue  String   @map("primary_key_value")
  snapshotBefore   String   @map("snapshot_before")
  snapshotAfter    String?  @map("snapshot_after")
  status           String   // PENDING | SUCCESS | FAILED
  revertedByEventId String?  @map("reverted_by_event_id")
  revertingEvent    AuditEvent? @relation("Reversion", fields: [revertedByEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revertedEvents   AuditEvent[] @relation("Reversion")
  executedAt       DateTime @default(now()) @map("executed_at")

  @@index([correlationId])
  @@map("audit_events")
}

model GuardianWhitelist {
  id         String   @id @default(uuid())
  schemaName String   @map("schema_name")
  tableName  String   @map("table_name")
  columnName String?  @map("column_name")
  isEditable Boolean  @default(true) @map("is_editable")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([schemaName, tableName, columnName])
  @@map("guardian_whitelist")
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  correlationId  String   @map("correlation_id")
  requestHash    String   @map("request_hash")
  status         String   // PENDING | SUCCESS | FAILED
  responseBody   String?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("OPERATOR") // ADMIN | OPERATOR
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model DemoRecord {
  id         String   @id @default(uuid())
  name       String
  value      String
  isActive   Boolean  @default(true) @map("is_active")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("demo_records")
}

model OscarPrueba {
  id_Empresa                    Int
  id_Sucursal                   Int      @db.SmallInt
  id_Almacen                    Int      @db.SmallInt
  nb_Almacen                    String   @db.VarChar(Max)
  id_TipoAlmacen                Int      @db.SmallInt
  nb_AlmacenCorto               String?  @db.VarChar(Max)
  nu_Telefono                   String   @db.VarChar(Max)
  de_Direccion                  String   @db.VarChar(Max)
  sn_InventarioBloqueado        Boolean? @db.Bit
  id_EmpresaEmpleadoResponsable Int?
  id_EmpleadoResponsable        Int?     @db.SmallInt
  id_ReferenciaContable         String?  @db.VarChar(Max)
  sn_AlmacenNuevo               Boolean? @db.Bit
  sn_ActivoSession              Int?
  id_AlmacenFisico              Int?     @db.SmallInt
  id_TipoAlmacenGrupo           Int?     @db.SmallInt
  sn_CierreOdoo                 Boolean? @db.Bit
  sn_Activo                     Boolean? @db.Bit
  de_Horario                    String?  @db.VarChar(Max)

  @@id([id_Empresa, id_Sucursal, id_Almacen])
  @@map("oscar_prueba")
}
